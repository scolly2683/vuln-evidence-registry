{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scolly2683/vuln-evidence-registry/precondition_extraction/tests/fixtures/schema.json",
  "title": "Precondition extraction fixture",
  "description": "One test case: a real advisory's text, paired with the structured CPE/precondition data an extractor is expected to produce from it. See README.md in this directory for a plain-English walkthrough of every field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cve_id", "ghsa_id", "source", "source_url", "retrieved", "advisory_text", "expected"],
  "properties": {
    "cve_id": {
      "type": "string",
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
    },
    "ghsa_id": {
      "type": ["string", "null"],
      "pattern": "^GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}$"
    },
    "source": {
      "type": "string",
      "enum": ["nvd", "ghsa"]
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "retrieved": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "advisory_text": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "affected_versions", "preconditions"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor", "product", "cpe", "purl"],
          "properties": {
            "vendor": { "type": "string", "minLength": 1 },
            "product": { "type": "string", "minLength": 1 },
            "cpe": { "type": ["string", "null"] },
            "purl": { "type": ["string", "null"] }
          }
        },
        "affected_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["introduced", "fixed", "excluded_fixed"],
          "properties": {
            "introduced": { "type": ["string", "null"] },
            "fixed": { "type": ["string", "null"] },
            "excluded_fixed": {
              "type": "array",
              "items": { "type": "string" }
            },
            "notes": { "type": ["string", "null"] }
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "category",
              "enabled_by_default",
              "required_for_exploit"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "statement": { "type": "string", "minLength": 1 },
              "category": {
                "type": "string",
                "enum": [
                  "configuration",
                  "deployment",
                  "api-usage",
                  "network-reachability",
                  "platform"
                ]
              },
              "enabled_by_default": { "type": ["boolean", "null"] },
              "required_for_exploit": { "type": "boolean" }
            }
          }
        },
        "remediation_notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "text"],
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "vendor_fix",
                  "workaround",
                  "mitigation",
                  "none_available",
                  "no_fix_planned"
                ]
              },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "general_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
